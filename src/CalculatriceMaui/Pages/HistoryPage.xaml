<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatriceMaui.Pages.HistoryPage"
             Title="Historique"
             BackgroundColor="{AppThemeBinding Light={StaticResource CalcFond}, Dark={StaticResource CalcFondSombre}}">

    <!-- La page reprend les mêmes conteneurs que la calculatrice : Grid pour la
         structure, HorizontalStackLayout pour la barre supérieure et
         CollectionView pour la liste des calculs. -->
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre supérieure : résumé + vidage de l'historique. -->
        <HorizontalStackLayout Grid.Row="0"
                               Padding="16,10"
                               Spacing="8"
                               BackgroundColor="{AppThemeBinding Light={StaticResource CalcSurface}, Dark={StaticResource CalcSurfaceSombre}}">
            <Label x:Name="LabelResume"
                   VerticalOptions="Center"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource CalcTexteSecondaire}, Dark={StaticResource CalcTexteSecondaireSombre}}" />
            <Button Text="Tout effacer"
                    Padding="10,4"
                    FontSize="12"
                    CornerRadius="12"
                    TextColor="{StaticResource CalcErreur}"
                    BackgroundColor="Transparent"
                    BorderWidth="1"
                    BorderColor="{AppThemeBinding Light={StaticResource CalcFonctionClaire}, Dark={StaticResource CalcFonctionSombre}}"
                    TextTransform="None"
                    Clicked="OnToutEffacerClicked"
                    SemanticProperties.Description="Vider l'historique" />
        </HorizontalStackLayout>

        <Grid Grid.Row="1">
            <CollectionView x:Name="ListeHistorique"
                            ItemsSource="{Binding History}"
                            SelectionMode="Single"
                            SelectionChanged="OnSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="16,12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
                                   Style="{StaticResource HistoriqueExpression}"
                                   Text="{Binding Expression}"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"
                                   Style="{StaticResource HistoriqueResultat}"
                                   Text="{Binding ResultatTexte}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout x:Name="EtatVide"
                                 IsVisible="False"
                                 Spacing="6"
                                 Padding="32"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <Label Text="Aucun calcul enregistré"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource CalcTexteSecondaire}, Dark={StaticResource CalcTexteSecondaireSombre}}" />
                <Label Text="Revenez à la calculatrice et appuyez sur = : chaque opération apparaîtra ici."
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource CalcTexteSecondaire}, Dark={StaticResource CalcTexteSecondaireSombre}}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
