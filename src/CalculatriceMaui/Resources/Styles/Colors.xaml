<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette du thème clair (les valeurs sombres sont dans les styles). -->
    <Color x:Key="Primary">#4C5BD4</Color>
    <Color x:Key="Secondary">#3F4BB8</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray">#6B7280</Color>

    <!-- Fond général de la calculatrice. -->
    <Color x:Key="CalcFond">#F2F3F7</Color>
    <Color x:Key="CalcFondSombre">#12141C</Color>

    <!-- Carton de l'affichage. -->
    <Color x:Key="CalcSurface">#FFFFFF</Color>
    <Color x:Key="CalcSurfaceSombre">#1C1F2A</Color>

    <!-- Textes. -->
    <Color x:Key="CalcTexte">#11131A</Color>
    <Color x:Key="CalcTexteSombre">#F5F6FA</Color>
    <Color x:Key="CalcTexteSecondaire">#6B7280</Color>
    <Color x:Key="CalcTexteSecondaireSombre">#9AA1B2</Color>

    <!-- Touches. -->
    <Color x:Key="CalcChiffre">#FFFFFF</Color>
    <Color x:Key="CalcChiffreSombre">#262A38</Color>
    <Color x:Key="CalcOperateur">#E3E6F7</Color>
    <Color x:Key="CalcOperateurSombre">#2E3346</Color>
    <Color x:Key="CalcEgal">#4C5BD4</Color>
    <Color x:Key="CalcEgalSombre">#6E7BFF</Color>
    <Color x:Key="CalcFonctionClaire">#E9EBF2</Color>
    <Color x:Key="CalcFonctionSombre">#232734</Color>

    <!-- Accent et erreur. -->
    <Color x:Key="CalcAccent">#4C5BD4</Color>
    <Color x:Key="CalcErreur">#D92D20</Color>

</ResourceDictionary>
